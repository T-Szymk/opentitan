name: "lowrisc:systems:chip_darjeeling_vcu118:0.1"
description: "Darjeeling toplevel for the AMD/Xilinx VCU118 board"
filesets:
  files_rtl_vcu118:
    depend:
      - lowrisc:systems:top_darjeeling:0.1
      - lowrisc:systems:top_darjeeling_pkg
      - lowrisc:systems:top_darjeeling_padring
      - lowrisc:systems:top_darjeeling_ast
      - lowrisc:darjeeling_systems:pad_orient_pkg
      - lowrisc:darjeeling_systems:scan_role_pkg
      - lowrisc:prim_xilinx_ultrascale:all
    files:
      - rtl/clkgen_xil_ultrascale.sv
      - rtl/usr_access_xil7series.sv
      - rtl/autogen/chip_darjeeling_vcu118.sv
    file_type: systemVerilogSource

  files_constraints:
    files:
      - data/clocks_darjeeling_vcu118.xdc
      - data/pins_darjeeling_vcu118.xdc
    file_type: xdc

  files_ascentlint_waiver:
    depend:
      # common waivers
      - lowrisc:lint:common
      - lowrisc:lint:comportable
    file_type: waiver

parameters:
  # XXX: These parameters need to be absolute, or relative to the
  # *.runs/synth_1 directory. Pass them as absolute paths when invoking
  # fusesoc, e.g. via fpga_flow/scripts/build_rom_image.py's output paths.
  RomCtrl0BootRomInitFile:
    datatype: str
    description: Scrambled rom_ctrl0 boot ROM initialization file in vmem hex format
    default: ""
    paramtype: vlogparam

  RomCtrl1BootRomInitFile:
    datatype: str
    description: Scrambled rom_ctrl1 boot ROM initialization file in vmem hex format
    default: ""
    paramtype: vlogparam

  OtpMacroMemInitFile:
    datatype: str
    description: OTP macro initialization file in vmem hex format
    default: ""
    paramtype: vlogparam

  AST_BYPASS_CLK:
    datatype: bool
    description: Enable AST oscillator bypass so clkgen_xil_ultrascale's MMCM drives the clock tree instead of AST's own (non-synthesizable) PLL.
    default: true
    paramtype: vlogdefine

targets:
  default: &default_target
    filesets:
      - tool_ascentlint  ? (files_ascentlint_waiver)
      - files_rtl_vcu118
      - files_constraints
    toplevel: chip_darjeeling_vcu118
    parameters:
      - RomCtrl0BootRomInitFile
      - RomCtrl1BootRomInitFile
      - OtpMacroMemInitFile
      - AST_BYPASS_CLK

  synth:
    <<: *default_target
    default_tool: vivado
    tools:
      vivado:
        # XCVU9P-L2FLGA2104E per notes/ug1224-vcu118-eval-bd.pdf -- confirm this
        # exact Vivado part string (speed grade/temp grade suffix) against
        # `pr_part_help`/the Vivado part catalog before first use; the "-2L"/"-e"
        # suffixes below are the commonly documented encoding but unverified here.
        part: "xcvu9p-flga2104-2L-e"
