{
  "name": "opentitan_darjeeling_1_0_0",

  "image": "opentitan",
  "mounts":[
    {"source": "${localWorkspaceFolder}",                           "target": "/app/opentitan",    "type": "bind"},
    {"source": "/tmp/.X11-unix",                                    "target": "/tmp/.X11-unix",    "type": "bind"},
    {"source": "${localEnv:XAUTHORITY}",                            "target": "/root/.Xauthority", "type": "bind"},
    // make sure source matches directory containing /bin for questa version on host
    {"source": "/opt/tools/mentor/questaone_2025.3_1/",             "target": "/opt/questa",       "type": "bind"},
    {"source": "/opt/tools/synopsis/installs/vcs/X-2025.06-SP2-2/", "target": "/opt/synopsis",     "type": "bind"},
    {"source": "${localEnv:SSH_AUTH_SOCK}",                         "target": "/ssh-agent",        "type": "bind"}
  ],
  "workspaceFolder": "/app/opentitan",
  "remoteUser": "dev",
 
  // Env variables to be set in container
  "containerEnv": {
    "QUESTA_HOME": "/opt/questa",
    "VCS_HOME": "/opt/synopsis/installs/vcs/X-2025.06-SP2-2",
    "LM_LICENSE_FILE": "${localEnv:LM_LICENSE_FILE}",
    "SALT_LICENSE_SERVER": "${localEnv:SALT_LICENSE_SERVER}",
    "SNPSLMD_LICENSE_FILE": "${localEnv:SNPSLMD_LICENSE_FILE}",
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/${HOME}/.Xauthority"
  },

  "remoteEnv": {
    "PATH": "/opt/questa/questasim/linux_x86_64:${containerEnv:PATH}"
  },

  "postCreateCommand": {
    "vcs": "echo 'vcs() { bash \"${containerEnv:VCS_HOME}/bin/vcs\" \"$@\";' } >> /etc/bash.bashrc",
    "dve": "echo 'dve() { bash \"${containerEnv:VCS_HOME}/bin/dve\" \"$@\";' } >> /etc/bash.bashrc"
  },

  "runArgs": ["--network=host", "--security-opt", "seccomp=unconfined"],

  "customizations": {
    "vscode": {
      
      "extensions": [
        "laktak.hjson",
        "hudson-river-trading.vscode-slang",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "rashwell.tcl",
        "anthropic.claude-code",
        "eamodio.gitlens",
        "charliermarsh.ruff",
        "rust-lang.rust-analyzer",
        "hbohlin.vhdl-ls"
      ],

      "settings": {
        "docker.cpus": "8",
        "slang.path": "/tools/slang-server/build/bin/slang-server",
        "C_Cpp.default.includePath": [
          "${workspaceRoot}/**/*.h"
        ],
        "vhdl_ls.enable": false,
        "python.analysis.typeCheckingMode": "standard"
      }
    }
  } 
}
