{
  "name": "opentitan_darjeeling_1_0_0",

  "image": "tomszymkowiak/darjeeling_1_0_0:1.1",
  "mounts":[
    {"source": "${localWorkspaceFolder}",                       "target": "/app/opentitan",  "type": "bind"},
    {"source": "/tmp/.X11-unix",                                "target": "/tmp/.X11-unix",  "type": "bind"},
    // make sure source matches directory containing /bin for questa version on host
    {"source": "/opt/tuni/mentor/questaone_2025.3_1/questasim", "target": "/opt/questa",     "type": "bind"}
  ],
  "workspaceFolder": "/app/opentitan",
  "remoteUser": "root",
 
  // Env variables to be set in container
  "containerEnv": {
    "HOME": "/home",
    "QUESTA_ROOT": "/opt/questa",
    "LM_LICENSE_FILE": "${localEnv:LM_LICENSE_FILE}",
    "SALT_LICENSE_SERVER": "${localEnv:SALT_LICENSE_SERVER}"
  },

  "remoteEnv": {
    "PATH": "/opt/questa/bin:${containerEnv:PATH}"
  },

  "runArgs": ["--network=host"],

  "postCreateCommand": "apt-get update && apt-get install -y locales && locale-gen en_US.UTF-8 && update-locale LANG=en_US.UTF-8 && dpkg --add-architecture i386 && apt-get update && apt-get install -y libxft2 libxft2:i386 libxt6 libxt6:i386 libx11-6 libx11-6:i386 libxrender1 libxrender1:i386 libxext6 libxext6:i386 libfreetype6 libfreetype6:i386 libc6:i386 libstdc++6:i386",
 
  "customizations": {
    "vscode": {
      "settings": {
        "docker.cpus": "8",
        "slang.path": "/tools/slang-server/build/bin/slang-server",
        "C_Cpp.default.includePath": [
          "${workspaceRoot}/**/*.h"
        ]
      },
      "extensions": [
        "hudson-river-trading.vscode-slang",
        "ms-vscode.cpptools-extension-pack",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "rashwell.tcl",
        "anthropic.claude-code",
        "eamodio.gitlens"
      ]
    }
  }  
}

//# Locales
//apt update && apt-get install -y locales && locale-gen en_US.UTF-8 && update-locale LANG=en_US.UTF-8
//
//# i386 architecture + X11/GUI libs for Questa
//dpkg --add-architecture i386 && apt-get update && apt-get install -y libxft2 libxft2:i386 libxt6 libxt6:i386 libx11-6 libx11-6:i386 libxrender1 libxrender1:i386 libxext6 libxext6:i386 libfreetype6 libfreetype6:i386 libc6:i386 libstdc++6:i386